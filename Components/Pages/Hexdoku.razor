@page "/hexdoku"
@using System.Text.Json
@using System.Text.Json.Serialization

@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>Hexdoku</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h3" GutterBottom="true">Hexdoku</MudText>

    <MudGrid Spacing="2" Justify="Justify.FlexStart" Class="mb-4">
        <MudItem xs="12" sm="8" Class="d-flex align-center flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mr-2 mb-2" OnClick="LoadPuzzle">Load Puzzle
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mr-2 mb-2" OnClick="SolvePuzzle">Solve
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="mr-2 mb-2" OnClick="ClearGrid">Clear
            </MudButton>
            <MudCheckBox T="bool" @bind-Value="HighlightErrors" Label="Highlight Errors" Color="Color.Error"
                Class="mb-2"></MudCheckBox>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect @bind-Value="SelectedDifficulty" Label="Difficulty" Variant="Variant.Outlined">
                <MudSelectItem Value="@("easy")">Easy</MudSelectItem>
                <MudSelectItem Value="@("medium")">Medium</MudSelectItem>
                <MudSelectItem Value="@("hard")">Hard</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <div id="hexdoku-grid"></div>

    <MudText Typo="Typo.body1" Class="mt-4">
        <p>Hexdoku is a variant of Sudoku played on a hexagonal grid. The objective is to fill the grid with Hexadecimal
            numbers (0-9 and A-F) such that each number appears exactly once in each row, column, and hexagon.</p>
        <p>Enjoy solving!</p>
    </MudText>

    <br />

    <MudButton OnClick="OnExpandCollapseClick" Color="Color.Primary">Learn More About This Project</MudButton>
    <MudDivider />
    <MudCollapse Expanded="_expanded">
        <MudPaper Class="pa-8 text-center" Elevation="2">
            <MudText Class="mb-4">I wanted to make a fun little twist on sudoku for programmers and other nerds.
            </MudText>
            <MudText Class="mb-4">During this project, I ran into issues with C# taking up way too much memory and time
                trying to generate the puzzles itself, so I turned to everyone's best friend when data is taking too
                long:
                Python. Having the puzzles pre-generated saved a lot of time and resources. After generating the
                puzzles,
                they (along with their solutions) were saved to a json.</MudText>
            <MudText Class="mb-4">There are 5 unique puzzles per difficulty because 5 is an amazing number.</MudText>
            <MudText Class="mb-4">The grid itself is actually rendered with javascript and embedded into the surrounding
                Blazor page. Blazor is great at many things, but something like this was not its strong-suit. Using JS
                was
                far more efficient.</MudText>
            <MudText Class="mb-4">All of the buttons however were kept as Blazor items in order to preserve the site
                flow.
                They are sent via an injected IJSRuntime.</MudText>
            <MudText Class="mb-4">So this page is actually made possible by mashing together C#/Blazor, Javascript, and
                Python!</MudText>
        </MudPaper>
    </MudCollapse>

</MudContainer>

@code {
    private HexdokuPuzzles? AllPuzzles { get; set; }
    private HexdokuPuzzle? CurrentPuzzle { get; set; }
    private int CurrentPuzzleIndex { get; set; } = -1;
    bool _expanded = false;

    private string _selectedDifficulty = "easy";
    private string SelectedDifficulty
    {
        get => _selectedDifficulty;
        set
        {
            if (_selectedDifficulty != value)
            {
                _selectedDifficulty = value;
                _ = LoadPuzzle();
            }
        }
    }
    private bool _highlightErrors = false;
    private bool HighlightErrors
    {
        get => _highlightErrors;
        set
        {
            if (_highlightErrors != value)
            {
                _highlightErrors = value;
                _ = JSRuntime.InvokeVoidAsync("Hexdoku.setHighlightErrors", _highlightErrors);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync("hexdoku.json");
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                AllPuzzles = JsonSerializer.Deserialize<HexdokuPuzzles>(jsonString, options);

                // Load initial puzzle after data is ready
                await LoadPuzzle();
            }
            else
            {
                Console.WriteLine($"Error loading hexdoku puzzles: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading hexdoku puzzles: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("Hexdoku.init", DotNetObjectReference.Create(this));
            await JSRuntime.InvokeVoidAsync("Hexdoku.setHighlightErrors", HighlightErrors);

            // Only load puzzle if data is available
            if (AllPuzzles != null)
            {
                await LoadPuzzle();
            }
        }
    }

    private void OnExpandCollapseClick()
    {
        _expanded = !_expanded;
    }

    private async Task LoadPuzzle()
    {
        if (AllPuzzles == null) return;

        var puzzles = SelectedDifficulty switch
        {
            "easy" => AllPuzzles.Easy,
            "medium" => AllPuzzles.Medium,
            "hard" => AllPuzzles.Hard,
            _ => new List<HexdokuPuzzle>()
        };

        if (puzzles.Any())
        {
            // Load a random puzzle from the selected difficulty
            var rand = new Random();
            CurrentPuzzleIndex = rand.Next(puzzles.Count);
            CurrentPuzzle = puzzles[CurrentPuzzleIndex];
            await JSRuntime.InvokeVoidAsync("Hexdoku.createGrid", CurrentPuzzle?.Puzzle);
        }
        else
        {
            // In case where no puzzles exist for the difficulty
            await JSRuntime.InvokeVoidAsync("Hexdoku.clearGrid");
            Console.WriteLine($"No puzzles found for difficulty: {SelectedDifficulty}");
        }
    }

    private async Task SolvePuzzle()
    {
        if (CurrentPuzzle?.Solution == null) return;
        await JSRuntime.InvokeVoidAsync("Hexdoku.solveGrid", CurrentPuzzle.Solution);
    }

    private async Task ClearGrid()
    {
        if (CurrentPuzzle?.Puzzle == null) return;
        await JSRuntime.InvokeVoidAsync("Hexdoku.createGrid", CurrentPuzzle.Puzzle);
    }

    // Method to be called from JavaScript if needed (e.g., for error checking)
    [JSInvokable]
    public List<List<string>>? GetSolution()
    {
        return CurrentPuzzle?.Solution;
    }

    // Method to be called from JavaScript to update the highlight errors checkbox
    [JSInvokable]
    public void SetHighlightErrors(bool value)
    {
        HighlightErrors = value;
        StateHasChanged();
    }

    // Models
    public class HexdokuPuzzles
    {
        public List<HexdokuPuzzle> Easy { get; set; } = new();
        public List<HexdokuPuzzle> Medium { get; set; } = new();
        public List<HexdokuPuzzle> Hard { get; set; } = new();
    }

    public class HexdokuPuzzle
    {
        public List<List<string>> Puzzle { get; set; } = new();
        public List<List<string>> Solution { get; set; } = new();
    }
}