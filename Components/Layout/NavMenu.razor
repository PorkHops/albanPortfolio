@using MudBlazor
@using MudBlazor.Components

<MudNavLink Href="/albanPortfolio/" Icon="@Icons.Material.Filled.Home" Class="rounded-lg px-3"
    ActiveClass="active-nav-link" Match="NavLinkMatch.All">
    HOME
</MudNavLink>
<MudNavLink Href="/albanPortfolio/projects" Icon="@Icons.Material.Filled.Business" Class="rounded-lg px-3"
    ActiveClass="active-nav-link">
    PROJECTS
</MudNavLink>
@if (IsAppBar)
{
    <MudMenu StartIcon="@Icons.Material.Filled.PlayArrow" Label="DEMOS" Expanded="false" Class="rounded-lg px-3">
        <MudMenuItem Href="/albanPortfolio/cryptogram" Icon="@Icons.Material.Filled.Deblur">Cryptogram</MudMenuItem>
        <MudMenuItem Href="/albanPortfolio/hexdoku" Icon="@Icons.Material.Filled.Grid4x4">Hexdoku</MudMenuItem>
    </MudMenu>
}
else
{
    <MudNavGroup Icon="@Icons.Material.Filled.PlayArrow" Title="DEMOS" Expanded="false" Class="rounded-lg px-3">
        <MudNavLink Href="/albanPortfolio/cryptogram" Icon="@Icons.Material.Filled.Deblur">Cryptogram</MudNavLink>
        <MudNavLink Href="/albanPortfolio/hexdoku" Icon="@Icons.Material.Filled.Grid4x4">Hexdoku</MudNavLink>
    </MudNavGroup>
}

<MudNavLink Href="/albanPortfolio/contactPage" Icon="@Icons.Material.Filled.Email" Class="rounded-lg px-3"
    ActiveClass="active-nav-link">
    CONTACT
</MudNavLink>

@code {
    [Parameter]
    public bool IsAppBar { get; set; }
}